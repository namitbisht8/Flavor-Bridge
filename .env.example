# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local or any file with real keys.

# "sample" uses the built-in sample data, "live" calls the Foodoscope APIs
API_MODE=sample

# From the Foodoscope dashboard (https://www.foodoscope.com). Server-side only.
FOODOSCOPE_API_KEY=your_key_here

# Optional: for photo scan and the assistant. Server-side only.
GEMINI_API_KEY=your_key_here
